# KnowledgeFlow AI local environment
# Copy this file to .env. Never commit .env or a real API key.
NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local document ingestion
MAX_UPLOAD_SIZE_MB=10
STORAGE_DIRECTORY=storage/documents
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# AI providers
# Free/offline mock mode (default): keep both values as mock and leave OPENAI_API_KEY empty.
# Real OpenAI mode: set both providers to openai and provide OPENAI_API_KEY in your local .env.
# Mixed modes are supported for development, but stored document vectors must always match AI_PROVIDER.
AI_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=

# OpenAI model examples. These are model identifiers, not credentials.
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini

# Provider safeguards and the fixed pgvector schema dimension
OPENAI_TIMEOUT_MS=30000
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_CHARACTERS=12000
LLM_MAX_OUTPUT_TOKENS=800

# Retrieval and bounded context
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.15
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_MAX_HISTORY_MESSAGES=10

# Local PostgreSQL container
POSTGRES_DB=knowledgeflow
POSTGRES_USER=knowledgeflow
POSTGRES_PASSWORD=knowledgeflow_dev
POSTGRES_PORT=5432

# Use localhost from applications running directly on the host machine.
DATABASE_URL=postgresql://knowledgeflow:knowledgeflow_dev@localhost:5432/knowledgeflow
