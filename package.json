{
  "name": "knowledgeflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "An internal company knowledge assistant built around a transparent RAG pipeline.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate --workspace @knowledgeflow/api",
    "db:migrate:down": "npm run db:migrate:down --workspace @knowledgeflow/api",
    "db:migrate:status": "npm run db:migrate:status --workspace @knowledgeflow/api",
    "db:up": "docker compose up -d postgres",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace @knowledgeflow/api",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
